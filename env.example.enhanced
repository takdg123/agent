# Enhanced Torri System Configuration
# Copy this file to .env and configure your settings

# ============================================================================
# Database Configuration
# ============================================================================
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION=daily_knowledge

# ============================================================================
# LLM Configuration - Ollama
# ============================================================================
OLLAMA_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434

# ============================================================================
# LLM Configuration - OpenAI-Compatible (Qwen, vLLM, etc.)
# ============================================================================
# Enable this for vision-capable models like Qwen2.5-VL
OPENAI_COMPATIBLE_ENABLED=false
OPENAI_COMPATIBLE_URL=http://localhost:8000/v1
OPENAI_COMPATIBLE_API_KEY=EMPTY
OPENAI_COMPATIBLE_MODEL=Qwen2.5-VL-7B-Instruct

# ============================================================================
# LLM Settings
# ============================================================================
LLM_TIMEOUT=120
GPU_DEVICE=0

# ============================================================================
# Vision Processing Configuration
# ============================================================================
# Convert PDFs to images for vision-enabled LLMs
VISION_ENABLED=true
VISION_DPI=150
VISION_MAX_PAGES=5
VISION_IMAGE_FORMAT=png

# ============================================================================
# Agent Harness Configuration
# ============================================================================
# Enable multi-agent coordination system
HARNESS_ENABLED=true

# ============================================================================
# PDF Processing Configuration
# ============================================================================
PDF_CHUNK_SIZE=800
PDF_OVERLAP_SIZE=150
MAX_PDF_CONTENT=100000

# ============================================================================
# Report Configuration
# ============================================================================
MAX_PAPERS=20
REPORT_TIME=10:00

# ============================================================================
# Email Configuration (Optional)
# ============================================================================
# Gmail configuration for email reports
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-16-char-app-password
RECIPIENT_EMAIL=recipient@example.com

# ============================================================================
# System Configuration
# ============================================================================
SYSTEM_NAME=TORRI

# ============================================================================
# Setup Instructions
# ============================================================================

# 1. Basic Setup (Ollama only):
#    - Install Ollama: https://ollama.ai
#    - Run: ollama run llama4:latest
#    - Set OLLAMA_ENABLED=true

# 2. Enhanced Setup (Ollama + Qwen Vision):
#    - Install vLLM: pip install vllm
#    - Start Qwen server:
#      python -m vllm.entrypoints.openai.api_server \
#        --model Qwen/Qwen2.5-VL-7B-Instruct \
#        --trust-remote-code \
#        --port 8000
#    - Set OPENAI_COMPATIBLE_ENABLED=true

# 3. Vision Features:
#    - Install PyMuPDF: pip install PyMuPDF
#    - Set VISION_ENABLED=true

# 4. Email (Optional):
#    - Use Gmail App Password (not regular password)
#    - See EMAIL_SETUP.md for details

# 5. Database:
#    - Install Docker
#    - Run: docker run -p 6333:6333 qdrant/qdrant
